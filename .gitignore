# This .gitignore file is placed at the repository root.
# The Unity project lives in the nested "Yongxian/" subfolder,
# so Unity-specific paths below are anchored to that folder.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
Yongxian/[Ll]ibrary/
Yongxian/[Tt]emp/
Yongxian/[Oo]bj/
Yongxian/[Bb]uild/
Yongxian/[Bb]uilds/
Yongxian/[Ll]ogs/
Yongxian/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
Yongxian/[Mm]emoryCaptures/

# Recordings can get excessive in size
Yongxian/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# Yongxian/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Yongxian/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
Yongxian/ServerData
Yongxian/[Aa]ssets/StreamingAssets/aa*
Yongxian/[Aa]ssets/AddressableAssetsData/link.xml*
Yongxian/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# Yongxian/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
Yongxian/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
Yongxian/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Yongxian/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Yongxian/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Yongxian/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
Yongxian/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
Yongxian/[Aa]ssets/[Ss]ceneDependencyCache*